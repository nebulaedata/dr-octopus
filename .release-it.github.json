{
  "$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
  "git": {
    "requireCleanWorkingDir": true,
    "requireUpstream": false,
    "commit": false,
    "tag": false,
    "push": false,
    "pushRepo": "origin",
    "tagName": "v${version}",
    "changelog": false
  },
  "npm": false,
  "github": {
    "release": true,
    "releaseName": "v${version}",
    "autoGenerate": true,
    "tokenRef": "GITHUB_TOKEN",
    "comments": { "submit": false }
  },
  "gitlab": { "release": false }
}
