{
  "name": "@octopus/executor",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "assemble:packaging": "node scripts/package/assemble-packaging.mjs",
    "package:acceptance": "node scripts/package/package.mjs",
    "publish:release": "node scripts/package/publish-release.mjs",
    "prepare:acceptance-kit": "node scripts/package/prepare-acceptance-kit.mjs",
    "test:packaging": "node --import tsx --test --test-concurrency=1 test/packaging/*.test.mjs",
    "assemble:computer": "node scripts/resources/assemble-computer.mjs",
    "assemble:node": "node scripts/resources/assemble-node.mjs",
    "dev": "node scripts/compile/dev.mjs",
    "build": "node scripts/compile/build.mjs",
    "build:native": "node scripts/compile/build-native.mjs",
    "start": "electron .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.renderer.json",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.mjs test/native/*.test.mjs",
    "test:native": "node --import tsx --test --test-concurrency=1 test/native/*.test.mjs",
    "test:integration": "node --import tsx --test --test-concurrency=1 test/integration/*.test.mjs",
    "assemble:search": "node scripts/resources/assemble-search.mjs",
    "assemble:node-headers": "node scripts/resources/assemble-node-headers.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@octopus/shared": "workspace:*",
    "@octopus/ui": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.35",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fflate": "0.8.3",
    "globals": "17.7.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.3.0"
  }
}
