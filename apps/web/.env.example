# Public build-time configuration; never put credentials in VITE_* values.
# Executor has its own version, independent from the Web release.
VITE_EXECUTOR_VERSION=0.0.1
# Configure exact published artifact URLs (HTTP(S) or same-origin /downloads/ paths).
# Leave empty until artifacts are available; the dialog then disables downloading.
VITE_EXECUTOR_WINDOWS_INSTALLER_URL=
VITE_EXECUTOR_WINDOWS_ZIP_URL=
