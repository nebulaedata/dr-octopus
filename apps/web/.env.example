# Public build-time overrides; never put credentials in VITE_* values.
# By default, the version comes from apps/executor/package.json and download URLs
# use the current repository Release from release.config.json (e.g. v0.0.13).
# Leave these overrides unset to follow each new Release automatically.
# VITE_EXECUTOR_VERSION=0.0.1
# VITE_EXECUTOR_WINDOWS_INSTALLER_URL=https://github.com/nebulaedata/dr-octopus/releases/download/v0.0.13/Dr.Octopus-Executor-0.0.1-win-x64-unsigned.exe
# VITE_EXECUTOR_WINDOWS_ZIP_URL=https://github.com/nebulaedata/dr-octopus/releases/download/v0.0.13/Dr.Octopus-Executor-0.0.1-win-x64-unsigned.zip
# HTTP(S) mirrors and same-origin /downloads/ paths are supported.
# Set an override to an empty value to disable that individual format.
