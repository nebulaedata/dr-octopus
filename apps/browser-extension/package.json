{
  "name": "@octopus/browser-extension",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test test/*.test.mjs",
    "test:window-panel": "node --test --test-concurrency=1 test/integration/window-panel.test.mjs",
    "test:popup": "node --test --test-concurrency=1 test/integration/popup.test.mjs",
    "test:recording": "node --test --test-concurrency=1 test/integration/recording.test.mjs test/integration/recording-semantics.test.mjs",
    "test:recording-lifecycle": "node --test --test-concurrency=1 test/integration/recording-lifecycle.test.mjs",
    "test:skill-agent": "node --test --test-concurrency=1 test/skill-session.test.mjs test/skill-replay-feasibility.test.mjs test/integration/skill-session-storage.test.mjs test/integration/skill-service.test.mjs test/integration/session-deletion.test.mjs test/integration/agent-question-form.test.mjs test/integration/agent-conversation.test.mjs test/integration/recording-skill-entry.test.mjs test/integration/skill-library-ui.test.mjs",
    "package:licenses": "node scripts/licenses.mjs",
    "test:settings": "node --test --test-concurrency=1 test/integration/model-settings.test.mjs test/integration/settings-toast.test.mjs test/integration/execution-limits.test.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.80",
    "@base-ui/react": "1.8.0",
    "@noble/hashes": "1.8.0",
    "@octopus/custom-ui": "workspace:*",
    "@octopus/shared": "workspace:*",
    "@octopus/ui": "workspace:*",
    "@page-agent/page-controller": "1.12.4",
    "@tanstack/react-form": "1.33.5",
    "ai": "7.0.155",
    "date-fns": "4.4.0",
    "fflate": "0.8.3",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "dotenv": "17.4.2",
    "esbuild": "0.28.2",
    "eslint": "10.8.0",
    "globals": "17.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "wxt": "0.21.4"
  }
}
