{
  "name": "@octopus/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/server-build-clean.mjs && tsc -p tsconfig.build.json && node scripts/server-db-migrations-copy.mjs",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "dev": "pnpm --filter @octopus/agent build && node scripts/dev-watch.mjs --env-file-if-exists=../../.env",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "test:e2e:sse": "node --test test/e2e/business-data-sse.test.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.0",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@fastify/autoload": "^6.5.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/vite": "10.0.0",
    "@fastify/websocket": "^11.3.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@napi-rs/canvas": "^1.0.8",
    "@octopus/agent": "workspace:*",
    "@octopus/document-processing": "workspace:*",
    "@octopus/env-loader": "workspace:*",
    "@octopus/shared": "workspace:*",
    "@tus/server": "^2.4.4",
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "csv-parse": "^7.0.2",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.11.0",
    "fastify-plugin": "^6.0.0",
    "fflate": "^0.8.3",
    "file-type": "^22.0.2",
    "pdfjs-dist": "^6.3.289",
    "pi-mcp-adapter": "2.34.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "saxes": "^6.0.0",
    "sharp": "^0.35.4",
    "ws": "^8.21.3",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=11.0.0"
  },
  "exports": {
    "./host": {
      "types": "./dist/host.d.ts",
      "default": "./dist/host.js"
    },
    ".": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    }
  }
}
