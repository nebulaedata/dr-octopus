{
  "schemaVersion": 1,
  "outputDirectory": "release",
  "readme": "README.md",
  "readmeTranslations": {
    "README.zh-CN.md": "README.zh-CN.md"
  },
  "buildArgs": ["build"],
  "manifest": {
    "name": "dr-octopus",
    "license": "MIT",
    "version": "0.0.8",
    "description": "A local-first, workspace-scoped general-purpose agent system built on Pi.",
    "repository": {
      "type": "git",
      "url": "git+https://github.com/nebulaedata/dr-octopus.git"
    },
    "homepage": "https://github.com/nebulaedata/dr-octopus#readme",
    "bugs": {
      "url": "https://github.com/nebulaedata/dr-octopus/issues"
    },
    "keywords": ["pi", "agent", "octopus", "dr.octopus"],
    "engines": {
      "node": ">=22.19.0"
    }
  },
  "pnpmVersion": "11.18.0",
  "runtimeDirectory": ".dr-octopus/runtimes",
  "command": "dr-octopus",
  "bootstrap": {
    "package": "@octopus/cli",
    "path": "dist/cli.mjs",
    "destination": "bin/dr-octopus.mjs"
  },
  "archive": "payload/runtime.tar.gz",
  "installFilter": "@octopus/cli...",
  "artifacts": {
    "*": ["dist"],
    "@octopus/agent": ["dist", "bin"]
  },
  "requiredFiles": [{ "package": "@octopus/agent", "path": "dist/bin/octopus.js" }],
  "paths": {
    "cli": {
      "package": "@octopus/cli",
      "path": "."
    },
    "server": {
      "package": "@octopus/server",
      "path": "."
    },
    "serverEntry": {
      "package": "@octopus/server",
      "path": "dist/runtime.js"
    },
    "gatewayEntry": {
      "package": "@octopus/cli",
      "path": "dist/gateway.mjs"
    },
    "webClient": {
      "package": "@octopus/web",
      "path": "dist/client"
    }
  }
}
