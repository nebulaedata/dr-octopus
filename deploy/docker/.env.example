# Use the latest stable image; set an exact tag to pin a version.
# Release ZIPs replace this with their tested version automatically.
IMAGE_TAG=latest

# Publish on all host interfaces. Browser URL: http://SERVER_IP:3000
BIND_ADDRESS=0.0.0.0
HTTP_PORT=3000

# Runtime npm downloads (for example, extensions installed on first startup).
# Optional mirror for China: https://registry.npmmirror.com
# This does not change Docker Hub pulls or how the published image was built.
NPM_CONFIG_REGISTRY=https://registry.npmjs.org

# Same-origin access by IP works with an empty value. For a domain or proxy,
# set the actual browser origin(s), including scheme and non-default port.
# Example: https://octopus.example.com,http://192.0.2.10:3000
# Comma-separated; no wildcard, path, query string, or trailing slash.
SERVER_CORS_ORIGIN=
LOG_LEVEL=info
