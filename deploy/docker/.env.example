# Choose an existing Docker Hub tag; release ZIPs pin this automatically.
IMAGE_TAG=0.0.9

# Publish on all host interfaces. Browser URL: http://SERVER_IP:3000
BIND_ADDRESS=0.0.0.0
HTTP_PORT=3000

# Same-origin access by IP works with an empty value. For a domain or proxy,
# set the actual browser origin(s), including scheme and non-default port.
# Example: https://octopus.example.com,http://192.0.2.10:3000
# Comma-separated; no wildcard, path, query string, or trailing slash.
SERVER_CORS_ORIGIN=
LOG_LEVEL=info
