# ------------- Server -------------
NODE_ENV=development
LOG_LEVEL=info
# 可选本地文件日志；stdout 始终保留，默认不启用
SERVER_FILE_LOG_ENABLED=false
# 留空时继承 LOG_LEVEL
SERVER_FILE_LOG_LEVEL=
SERVER_FILE_LOG_MAX_SIZE_MB=50
SERVER_FILE_LOG_RETENTION_DAYS=14
SERVER_FILE_LOG_MAX_FILES=30
SERVER_FILE_LOG_MAX_TOTAL_SIZE_MB=1024
# 启用后若初始化失败，是否阻止 Server 启动
SERVER_FILE_LOG_REQUIRED=false
SERVER_PORT=3000
SERVER_HOST=127.0.0.1
SERVER_CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
SERVER_HTTP_BODY_LIMIT_BYTES=146800640
SERVER_ATTACHMENT_LIMIT_BYTES=104857600
# Session Runtime Limits
SERVER_MAX_ACTIVE_RUNTIMES=9
# Session Runtime Limits per Workspace
SERVER_MAX_ACTIVE_RUNTIMES_PER_WORKSPACE=5
# Server 权威数据目录（默认：~/.dr-octopus/server；必须使用绝对路径）
SERVER_DATA_DIR=

# ------------- Agent -------------
# Pi Agent 数据目录（默认：~/.dr-octopus/agent；必须使用绝对路径）
DR_OCTOPUS_CODING_AGENT_DIR=
# Pi 启动时是否禁用网络操作（默认在线；设为 1 启用离线模式）
PI_OFFLINE=0
# 可选：安装 Pi 扩展时使用的 npm Registry
NPM_CONFIG_REGISTRY=https://registry.npmjs.org
# 可选：TypeSafe Jev 密钥，也可在设置 → Jev 中配置；记忆前置判断默认关闭
# TYPESAFE_API_KEY=your-typesafe-api-key
